rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Path: gallery/{imageId}/{fileName}
// Access:
//   - read: public (homepage gallery)
//   - write/delete: Admin SDK only (bypasses these rules via
//     /api/admin/gallery/* after requireAdminFromRequest)
//
// Path: store/{productId}/{fileName}
// Access:
//   - read: public (merchandise images)
//   - write/delete: Admin SDK only via /api/admin/products/*
//
// Path: hall-of-shame/pending/{reportId}/{fileName}
// Access:
//   - read/write: Admin SDK only (unpublished evidence)
//
// Path: hall-of-shame/published/{reportId}/{fileName}
// Access:
//   - read: public (moderated Hall of Shame photos)
//   - write/delete: Admin SDK only
//
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{imageId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /store/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /hall-of-shame/pending/{reportId}/{fileName} {
      allow read, write: if false;
    }

    match /hall-of-shame/published/{reportId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
