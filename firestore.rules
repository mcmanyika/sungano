rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function isValidNews(data) {
      return data.title is string
        && data.title.size() > 0
        && data.category is string
        && data.author is string
        && data.excerpt is string
        && data.body is string
        && data.image is string
        && data.published is bool
        && (!('views' in data) || (data.views is int && data.views >= 0));
    }

    function isNewsViewIncrement() {
      return resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    function isValidWelcomeVideo(data) {
      return data.title is string
        && data.title.size() > 0
        && data.description is string
        && data.youtubeId is string
        && data.published is bool;
    }

    function isValidVolunteer(data) {
      return data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.email is string
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 40
        && data.province is string
        && data.province.size() > 0
        && data.interest is string
        && data.interest.size() > 0
        && data.message is string
        && data.message.size() <= 2000;
    }

    function isValidEvent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.description is string
        && data.location is string
        && data.location.size() > 0
        && data.published is bool;
    }

    function isValidGalleryVideo(data) {
      return data.title is string
        && data.title.size() > 0
        && data.description is string
        && data.youtubeId is string
        && data.youtubeId.size() > 0
        && data.published is bool;
    }

    function isValidGalleryImage(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.alt is string
        && data.alt.size() <= 200
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2000
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 500
        && data.storagePath.matches('^gallery/.+')
        && data.published is bool;
    }

    function isValidStoreProduct(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.price is number
        && data.price > 0
        && data.price <= 100000
        && data.currency is string
        && data.currency in ['USD', 'ZAR', 'GBP', 'EUR']
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2000
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 500
        && data.storagePath.matches('^store/.+')
        && data.published is bool;
    }

    function isValidDeclaration(data) {
      return data.headline is string
        && data.headline.size() > 0
        && data.message is string
        && data.message.size() > 0
        && data.body is string;
    }

    function isValidSiteLink(link) {
      return link.keys().hasAll(['id', 'label', 'href'])
        && link.id is string
        && link.id.size() > 0
        && link.id.size() <= 80
        && link.label is string
        && link.label.size() > 0
        && link.label.size() <= 160
        && link.href is string
        && link.href.size() <= 500;
    }

    function isValidHeaderLink(link) {
      return isValidSiteLink(link)
        && link.keys().hasOnly(['id', 'label', 'href', 'megaMenu'])
        && (!('megaMenu' in link) || link.megaMenu is bool);
    }

    function isValidHeaderLinkList(list) {
      return list is list
        && list.size() >= 1
        && list.size() <= 12
        && isValidHeaderLink(list[0])
        && (list.size() < 2 || isValidHeaderLink(list[1]))
        && (list.size() < 3 || isValidHeaderLink(list[2]))
        && (list.size() < 4 || isValidHeaderLink(list[3]))
        && (list.size() < 5 || isValidHeaderLink(list[4]))
        && (list.size() < 6 || isValidHeaderLink(list[5]))
        && (list.size() < 7 || isValidHeaderLink(list[6]))
        && (list.size() < 8 || isValidHeaderLink(list[7]))
        && (list.size() < 9 || isValidHeaderLink(list[8]))
        && (list.size() < 10 || isValidHeaderLink(list[9]))
        && (list.size() < 11 || isValidHeaderLink(list[10]))
        && (list.size() < 12 || isValidHeaderLink(list[11]));
    }

    function isValidSiteLinkList(list, minSize, maxSize) {
      return list is list
        && list.size() >= minSize
        && list.size() <= maxSize
        && (list.size() < 1 || isValidSiteLink(list[0]))
        && (list.size() < 2 || isValidSiteLink(list[1]))
        && (list.size() < 3 || isValidSiteLink(list[2]))
        && (list.size() < 4 || isValidSiteLink(list[3]))
        && (list.size() < 5 || isValidSiteLink(list[4]))
        && (list.size() < 6 || isValidSiteLink(list[5]))
        && (list.size() < 7 || isValidSiteLink(list[6]))
        && (list.size() < 8 || isValidSiteLink(list[7]))
        && (list.size() < 9 || isValidSiteLink(list[8]))
        && (list.size() < 10 || isValidSiteLink(list[9]))
        && (list.size() < 11 || isValidSiteLink(list[10]))
        && (list.size() < 12 || isValidSiteLink(list[11]))
        && (list.size() < 13 || isValidSiteLink(list[12]))
        && (list.size() < 14 || isValidSiteLink(list[13]))
        && (list.size() < 15 || isValidSiteLink(list[14]));
    }

    function isValidSocialLink(link) {
      return link.keys().hasAll(['id', 'platform', 'label', 'href'])
        && link.keys().hasOnly(['id', 'platform', 'label', 'href'])
        && link.id is string
        && link.id.size() > 0
        && link.id.size() <= 80
        && link.platform in [
          'facebook',
          'x',
          'youtube',
          'instagram',
          'tiktok',
          'whatsapp'
        ]
        && link.label is string
        && link.label.size() > 0
        && link.label.size() <= 80
        && link.href is string
        && link.href.size() <= 500;
    }

    function isValidSocialLinkList(list) {
      return list is list
        && list.size() >= 0
        && list.size() <= 12
        && (list.size() < 1 || isValidSocialLink(list[0]))
        && (list.size() < 2 || isValidSocialLink(list[1]))
        && (list.size() < 3 || isValidSocialLink(list[2]))
        && (list.size() < 4 || isValidSocialLink(list[3]))
        && (list.size() < 5 || isValidSocialLink(list[4]))
        && (list.size() < 6 || isValidSocialLink(list[5]))
        && (list.size() < 7 || isValidSocialLink(list[6]))
        && (list.size() < 8 || isValidSocialLink(list[7]))
        && (list.size() < 9 || isValidSocialLink(list[8]))
        && (list.size() < 10 || isValidSocialLink(list[9]))
        && (list.size() < 11 || isValidSocialLink(list[10]))
        && (list.size() < 12 || isValidSocialLink(list[11]));
    }

    function isValidAboutMenu(menu) {
      return menu.keys().hasAll([
          'intro',
          'sectionTitle',
          'sectionDescription',
          'items'
        ])
        && menu.keys().hasOnly([
          'intro',
          'sectionTitle',
          'sectionDescription',
          'items'
        ])
        && isValidSiteLink(menu.intro)
        && menu.intro.keys().hasOnly(['id', 'label', 'href'])
        && menu.sectionTitle is string
        && menu.sectionTitle.size() > 0
        && menu.sectionTitle.size() <= 120
        && menu.sectionDescription is string
        && menu.sectionDescription.size() <= 300
        && isValidSiteLinkList(menu.items, 0, 15);
    }

    function isValidFooterLinks(footer) {
      return footer.keys().hasAll(['about', 'links', 'legal'])
        && footer.keys().hasOnly(['about', 'links', 'legal'])
        && isValidSiteLinkList(footer.about, 0, 12)
        && isValidSiteLinkList(footer.links, 0, 12)
        && isValidSiteLinkList(footer.legal, 0, 8);
    }

    function isValidNavigation(data) {
      return data.keys().hasAll([
          'header',
          'donate',
          'aboutMenu',
          'footer',
          'social',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'header',
          'donate',
          'aboutMenu',
          'footer',
          'social',
          'updatedAt'
        ])
        && isValidHeaderLinkList(data.header)
        && isValidSiteLink(data.donate)
        && data.donate.keys().hasOnly(['id', 'label', 'href'])
        && isValidAboutMenu(data.aboutMenu)
        && isValidFooterLinks(data.footer)
        && isValidSocialLinkList(data.social)
        && data.updatedAt is timestamp;
    }

    match /subscribers/{email} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.email == email
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.keys().hasAll(['email', 'source', 'subscribedAt'])
        && request.resource.data.source is string;
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /news/{articleId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidNews(request.resource.data);
      allow update: if (isAdmin() && isValidNews(request.resource.data))
        || isNewsViewIncrement();
      allow delete: if isAdmin();
    }

    match /content/declaration {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDeclaration(request.resource.data);
    }

    match /content/welcome-video {
      allow read: if true;
      allow create, update: if isAdmin() && isValidWelcomeVideo(request.resource.data);
    }

    // Public site chrome links (header, about mega menu, footer, social).
    match /content/navigation {
      allow read: if true;
      allow create, update: if isAdmin() && isValidNavigation(request.resource.data);
    }

    match /volunteers/{volunteerId} {
      allow read: if isAdmin();
      allow create: if isValidVolunteer(request.resource.data)
        && request.resource.data.keys().hasAll([
          'fullName',
          'email',
          'phone',
          'province',
          'interest',
          'message',
          'registeredAt'
        ]);
      allow delete: if isAdmin();
    }

    function isValidComment(data) {
      return data.articleId is string
        && data.articleId.size() > 0
        && data.articleTitle is string
        && data.articleTitle.size() <= 200
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 80
        && data.email is string
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.body is string
        && data.body.size() >= 2
        && data.body.size() <= 2000
        && data.approved is bool;
    }

    function isValidPollOption(option, expectedId) {
      return option.keys().hasOnly(['id', 'label'])
        && option.id == expectedId
        && option.label is string
        && option.label.size() > 0
        && option.label.size() <= 120;
    }

    function isValidPollOptions(options) {
      return options is list
        && options.size() >= 2
        && options.size() <= 6
        && isValidPollOption(options[0], 'o0')
        && isValidPollOption(options[1], 'o1')
        && (options.size() < 3 || isValidPollOption(options[2], 'o2'))
        && (options.size() < 4 || isValidPollOption(options[3], 'o3'))
        && (options.size() < 5 || isValidPollOption(options[4], 'o4'))
        && (options.size() < 6 || isValidPollOption(options[5], 'o5'));
    }

    function pollVotesSum(data) {
      return data.votes.get('o0', 0)
        + data.votes.get('o1', 0)
        + (data.options.size() >= 3 ? data.votes.get('o2', 0) : 0)
        + (data.options.size() >= 4 ? data.votes.get('o3', 0) : 0)
        + (data.options.size() >= 5 ? data.votes.get('o4', 0) : 0)
        + (data.options.size() >= 6 ? data.votes.get('o5', 0) : 0);
    }

    function votesMatchOptionCount(data) {
      return data.votes is map
        && data.votes.size() == data.options.size()
        && data.votes.keys().hasAll(['o0', 'o1'])
        && data.votes.o0 is int && data.votes.o0 >= 0
        && data.votes.o1 is int && data.votes.o1 >= 0
        && (data.options.size() < 3
          || (data.votes.keys().hasAll(['o2'])
            && data.votes.o2 is int && data.votes.o2 >= 0))
        && (data.options.size() < 4
          || (data.votes.keys().hasAll(['o3'])
            && data.votes.o3 is int && data.votes.o3 >= 0))
        && (data.options.size() < 5
          || (data.votes.keys().hasAll(['o4'])
            && data.votes.o4 is int && data.votes.o4 >= 0))
        && (data.options.size() < 6
          || (data.votes.keys().hasAll(['o5'])
            && data.votes.o5 is int && data.votes.o5 >= 0))
        && data.votes.keys().hasOnly(
          data.options.size() == 2 ? ['o0', 'o1']
          : data.options.size() == 3 ? ['o0', 'o1', 'o2']
          : data.options.size() == 4 ? ['o0', 'o1', 'o2', 'o3']
          : data.options.size() == 5 ? ['o0', 'o1', 'o2', 'o3', 'o4']
          : ['o0', 'o1', 'o2', 'o3', 'o4', 'o5']
        );
    }

    function isValidPoll(data) {
      return data.keys().hasAll([
          'question',
          'options',
          'votes',
          'totalVotes',
          'published',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'question',
          'options',
          'votes',
          'totalVotes',
          'published',
          'createdAt',
          'updatedAt'
        ])
        && data.question is string
        && data.question.size() > 0
        && data.question.size() <= 200
        && isValidPollOptions(data.options)
        && votesMatchOptionCount(data)
        && data.totalVotes is int
        && data.totalVotes >= 0
        && data.totalVotes == pollVotesSum(data)
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isSingleVoteBump(optionId) {
      return optionId in resource.data.votes
        && optionId in request.resource.data.votes
        && request.resource.data.votes[optionId] == resource.data.votes[optionId] + 1
        && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([optionId]);
    }

    function isPollVoteUpdate() {
      return resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'totalVotes'])
        && request.resource.data.totalVotes is int
        && request.resource.data.totalVotes == resource.data.totalVotes + 1
        && request.resource.data.votes is map
        && request.resource.data.votes.keys().hasOnly(resource.data.votes.keys())
        && resource.data.votes.keys().hasOnly(request.resource.data.votes.keys())
        && (
          isSingleVoteBump('o0')
          || isSingleVoteBump('o1')
          || isSingleVoteBump('o2')
          || isSingleVoteBump('o3')
          || isSingleVoteBump('o4')
          || isSingleVoteBump('o5')
        );
    }

    // Published polls are public; draft polls and writes (except vote bumps)
    // are admin-only.
    match /polls/{pollId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidPoll(request.resource.data);
      allow update: if (isAdmin() && isValidPoll(request.resource.data))
        || isPollVoteUpdate();
      allow delete: if isAdmin();
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll([
          'fullName',
          'email',
          'phone',
          'topic',
          'subject',
          'message',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'fullName',
          'email',
          'phone',
          'topic',
          'subject',
          'message',
          'status',
          'createdAt'
        ])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.email is string
        && data.email.size() <= 200
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.phone is string
        && data.phone.size() <= 40
        && data.topic in [
          'General enquiry',
          'Media enquiry',
          'Partnership',
          'Events',
          'Donations',
          'Technical support'
        ]
        && data.subject is string
        && data.subject.size() > 0
        && data.subject.size() <= 160
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 4000
        && data.status in ['new', 'resolved']
        && data.createdAt is timestamp;
    }

    // Contact messages contain PII and are readable only by admins.
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidContactMessage(request.resource.data)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && isValidContactMessage(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // Public can post comments (pending moderation). Only approved comments
    // are readable publicly; admins can approve, reject, and delete.
    match /comments/{commentId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if isValidComment(request.resource.data)
        && request.resource.data.approved == false
        && request.resource.data.keys().hasAll([
          'articleId',
          'articleTitle',
          'authorName',
          'email',
          'body',
          'approved',
          'createdAt'
        ]);
      allow update: if isAdmin()
        && isValidComment(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidEvent(request.resource.data);
      allow update: if isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidGalleryVideo(request.resource.data);
      allow update: if isAdmin() && isValidGalleryVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    match /images/{imageId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidGalleryImage(request.resource.data);
      allow update: if isAdmin() && isValidGalleryImage(request.resource.data);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidStoreProduct(request.resource.data);
      allow update: if isAdmin() && isValidStoreProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Store orders are written server-side (Stripe webhook / sync). Admins
    // may read them; clients cannot write.
    match /storeOrders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function isValidPartner(data) {
      return data.organisation is string
        && data.organisation.size() > 0
        && data.organisation.size() <= 200
        && data.name is string
        && data.name.size() <= 200
        && data.email is string
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // Partner accounts: readable and writable only by the owner.
    match /partners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isValidPartner(request.resource.data);
      allow delete: if false;
    }

    // Donations are written server-side via the Stripe webhook (Admin SDK,
    // which bypasses these rules). Clients may only read their own donations:
    // an admin sees all; a donor sees documents matching their token email or
    // their partner id. Direct client writes are never allowed.
    match /donations/{donationId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.email == request.auth.token.email)
        || (request.auth != null
            && resource.data.partnerId == request.auth.uid);
      allow write: if false;
    }

    // Inbound emails are written by the Resend webhook (Admin SDK). Admins can
    // read them and mark them as read; no other client writes are allowed.
    match /inboundEmails/{emailId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }
  }
}
